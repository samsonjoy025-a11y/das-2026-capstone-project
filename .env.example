# Copy to .env for local development (never commit .env).
# In production, set these as real environment variables.

# Secret for login/session JWTs (HS256). Use a long random value.
TOKEN_SECRET=

# Secret for signed ticket QR tokens (HMAC-SHA256). Must be different from TOKEN_SECRET.
TICKET_SECRET=

# Optional
# PORT=3000
# DATABASE_PATH=./data/ticketing.db
# NODE_ENV=development
